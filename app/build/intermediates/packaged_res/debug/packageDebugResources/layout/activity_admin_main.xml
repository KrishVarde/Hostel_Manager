<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Admin Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_header"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAdminTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hostel Warden Portal"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAdminSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Chief Warden Dr. K. Raman"
                    android:textColor="#C7D2FE"
                    android:textSize="12sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnAdminLogout"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_logout"
                app:tint="@color/white"
                android:contentDescription="Logout" />

        </LinearLayout>

        <!-- KPI Metrics Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatStudents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Students"
                    android:textSize="11sp"
                    android:textColor="#C7D2FE" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatRooms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rooms"
                    android:textSize="11sp"
                    android:textColor="#C7D2FE" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatComplaints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Issues"
                    android:textSize="11sp"
                    android:textColor="#C7D2FE" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatFees"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹69k"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fees Paid"
                    android:textSize="11sp"
                    android:textColor="#C7D2FE" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Content Sections -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. ROOMS SECTION -->
        <FrameLayout
            android:id="@+id/sectionRooms"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAdminRooms"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="8dp"
                android:paddingBottom="80dp"
                android:clipToPadding="false" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fabAddRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:text="Add Room"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary_dark"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/white" />

        </FrameLayout>

        <!-- 2. COMPLAINTS SECTION -->
        <LinearLayout
            android:id="@+id/sectionComplaints"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:orientation="vertical">

            <!-- Filter tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tabAdminCompAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="All"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:background="@drawable/bg_badge_progress"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/tabAdminCompPending"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginStart="6dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Pending"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tabAdminCompResolved"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginStart="6dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Resolved"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAdminComplaints"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false" />

        </LinearLayout>

        <!-- 3. FEES SECTION -->
        <LinearLayout
            android:id="@+id/sectionFees"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:text="Student Fee Ledger &amp; Collections"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAdminFees"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false" />

        </LinearLayout>

        <!-- 4. STUDENTS SECTION -->
        <LinearLayout
            android:id="@+id/sectionStudents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:text="Registered Hostel Residents Directory"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAdminStudents"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false" />

        </LinearLayout>

    </FrameLayout>

    <!-- Admin Bottom Nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="horizontal">

        <!-- Nav Rooms -->
        <LinearLayout
            android:id="@+id/adminNavRooms"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivAdminNavRooms"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_room"
                app:tint="@color/primary"
                android:contentDescription="Rooms" />

            <TextView
                android:id="@+id/tvAdminNavRooms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Rooms"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

        </LinearLayout>

        <!-- Nav Complaints -->
        <LinearLayout
            android:id="@+id/adminNavComplaints"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivAdminNavComplaints"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_complaint"
                app:tint="@color/text_hint"
                android:contentDescription="Complaints" />

            <TextView
                android:id="@+id/tvAdminNavComplaints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Complaints"
                android:textSize="11sp"
                android:textColor="@color/text_hint" />

        </LinearLayout>

        <!-- Nav Fees -->
        <LinearLayout
            android:id="@+id/adminNavFees"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivAdminNavFees"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_fee"
                app:tint="@color/text_hint"
                android:contentDescription="Fees" />

            <TextView
                android:id="@+id/tvAdminNavFees"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Fee Ledger"
                android:textSize="11sp"
                android:textColor="@color/text_hint" />

        </LinearLayout>

        <!-- Nav Students -->
        <LinearLayout
            android:id="@+id/adminNavStudents"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivAdminNavStudents"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_student"
                app:tint="@color/text_hint"
                android:contentDescription="Students" />

            <TextView
                android:id="@+id/tvAdminNavStudents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Directory"
                android:textSize="11sp"
                android:textColor="@color/text_hint" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
